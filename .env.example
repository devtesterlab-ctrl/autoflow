# ---------- Base de datos ----------
# Neon (recomendado para empezar): usar la conexión DIRECTA (sin "pooler").
# Docker local:  postgresql://autoflow:autoflow@localhost:5432/autoflow?schema=public
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require"

# ---------- Auth.js ----------
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# ---------- Dominios ----------
# En desarrollo: localhost:3000. En producción: tudominio.com (sin https://)
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
NEXT_PUBLIC_APP_SUBDOMAIN="app"

# ---------- Cloudflare R2 ----------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="autoflow-media"
# URL pública del bucket, ej: https://pub-xxxxxxxx.r2.dev (sin barra final)
R2_PUBLIC_URL=""

# ---------- Planes / registro (opcionales) ----------
NEXT_PUBLIC_UPGRADE_WHATSAPP=""
NEXT_PUBLIC_UPGRADE_PAYMENT_URL=""
REGISTRATION_INVITE_CODE=""

# ---------- Etapa 6: emails y administración ----------
# Resend (https://resend.com). Sin esta clave, en desarrollo los emails se imprimen en la terminal.
RESEND_API_KEY=""
EMAIL_FROM="AutoFlow <no-reply@tudominio.com>"
# Emails (separados por coma) con acceso a /admin. Deben ser usuarios ya registrados.
PLATFORM_ADMIN_EMAILS=""

# ---------- Etapa 7: producción ----------
# Conexión DIRECTA (sin pooler). En desarrollo es la MISMA cadena que DATABASE_URL.
# En producción (Neon): DATABASE_URL = cadena con pooler (+ &pgbouncer=true) y DIRECT_URL = cadena directa.
DIRECT_URL="postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require"

# Upstash Redis: límites de uso compartidos entre instancias (opcional en desarrollo)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Páginas legales
NEXT_PUBLIC_LEGAL_ENTITY=""     # ej: Juan Pérez (CUIT 20-12345678-9)
NEXT_PUBLIC_CONTACT_EMAIL=""    # ej: soporte@tudominio.com

# ---------- Sin dominio propio (opcional) ----------
# Para mostrar el catálogo de UNA agencia en la dirección de Vercel, sin comprar dominio:
#   SINGLE_TENANT_HOSTS="mi-proyecto.vercel.app=subdominio-de-la-agencia"
#   NEXT_PUBLIC_APP_ORIGIN="https://mi-proyecto.vercel.app"
SINGLE_TENANT_HOSTS=""
NEXT_PUBLIC_APP_ORIGIN=""
